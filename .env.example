# Copy to .env.local for local dev. Never commit real values.

# Resend — waitlist signups (app/api/waitlist/route.ts). Add these to the
# Vercel web project's Production environment; never prefix them with NEXT_PUBLIC_.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
RESEND_FROM_EMAIL=Zentrip <hello@zentrip.social>

# Zentrip API — powers the "Talk to Zenny" live voice demo on /meet-zenny.
# Local dev default is http://127.0.0.1:8001 (see zentrip/services/api). In
# production this must point at a publicly reachable, HTTPS deployment of that
# API with CORS_ORIGINS including this site's domain. Sarvam credentials belong
# on that API deployment only, never in this Vercel project.
NEXT_PUBLIC_ZENTRIP_API_URL=http://127.0.0.1:8001
